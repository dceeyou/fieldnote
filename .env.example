# AgriFlow Environment Variables
# Configure in .env.local for local development, or in Vercel Project Settings > Environment Variables.

# Supabase API Credentials (Public / Browser-safe)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Alternative aliases (compatible with Vercel / Next.js conventions)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
